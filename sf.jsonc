{
  "$schema": "https://spacefast.com/schemas/sf.json",
  "name": "Reel Together",
  "access": {
    "public": [
      "/**",
      "!/__zero/auth/api/sign-in/password",
      "!/__zero/auth/api/sign-in/email",
      "!/__zero/auth/api/sign-in/verify",
      "!/__zero/auth/api/sign-in/passkey/**"
    ]
  },
  "runtime": {
    "kind": "functions",
    "database": true,
    "fetch": true,
    "compatibilityDate": "2026-07-01"
  }
}
