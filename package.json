{
  "name": "reel-together-firebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/unit.test.mjs",
    "test:integration": "node scripts/test.mjs",
    "check": "npm test && npm run build && npm run test:integration",
    "deploy": "node scripts/deploy.mjs",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "firebase-tools": "^15.29.0",
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
