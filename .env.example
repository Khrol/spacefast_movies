# Copy to .env.server. Server variables are never embedded in the frontend.
APP_ORIGIN=https://your-space.view.fast
OWNER_EMAIL=owner@example.com
# SHA-256 of the one-use owner setup token; never store the token in Git.
OWNER_SETUP_HASH=
# Optional email delivery for account verification and password reset.
RESEND_API_KEY=
MAIL_FROM=
# Optional movie catalogs. Manual entries work without these.
KINOPOISK_TOKEN=
TMDB_TOKEN=
# Optional billing; remains disabled until its verified administration flow.
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_AUTOMATIC_TAX=false
